    <string name="g2_set_log_out_q">Log out?</string>
    <string name="g2_set_log_out_body">You can sign back in any time with your mobile number.</string>
    <string name="g2_set_delete_q">Delete your account?</string>
    <string name="g2_set_delete_body">This permanently removes your profile, phone number, posts, Moments, comments, messages and sign-in. It can\'t be undone.</string>
    <string name="g2_set_delete_mine">Delete my account</string>
    <string name="g2_safety_child">Your account is managed with a parent. Only approved syncs can message you.</string>
    <string name="g2_safety_teen">Teen protections are on for your account.</string>
    <string name="g2_safety_how">How Bucks keeps you safe</string>
    <string name="g2_rule_reach">You decide who reaches you</string>
    <string name="g2_rule_reach_d">By default, only people you\'ve synced with can message you. Change it in Privacy.</string>
    <string name="g2_rule_report">Report anything</string>
    <string name="g2_rule_report_d">Every post, comment, Moment, message and profile has Report. Reports are private, and our team reviews each one.</string>
    <string name="g2_rule_block">Block in one tap</string>
    <string name="g2_rule_block_d">A blocked person can\'t message you, sync with you or see your posts. They aren\'t told.</string>
    <string name="g2_rule_location">Your exact location stays private</string>
    <string name="g2_rule_location_d">Nearby uses an area of about 2 km. Your home is never shown.</string>
    <string name="g2_rule_minors">Extra care for under-18s</string>
    <string name="g2_rule_minors_d">Teens are private by default. Adults they don\'t know can\'t find them. A parent or guardian agrees when they join.</string>
    <string name="g2_set_privacy_settings">Privacy settings</string>
    <string name="g2_set_child_safety">Child safety standards</string>
    <string name="g2_safety_help_now">Need help now?</string>
    <string name="g2_safety_helplines">Emergency 112 · Childline 1098 · Tele-MANAS (mental health, free, 24×7) 14416 · Cyber crime helpline 1930</string>
    <string name="g2_faq_sync_q">What is a sync?</string>
    <string name="g2_faq_sync_a">A sync is a two-way connection, like a friend request. Once you\'re synced, you see each other\'s posts for syncs and can message each other.</string>
    <string name="g2_faq_who_q">Who can see my posts?</string>
    <string name="g2_faq_who_a">You choose for each post: Synced only, Nearby (people within about 5 km), or Everyone. Moments last 24 hours and go to syncs or close friends.</string>
    <string name="g2_faq_find_q">How do I find my friends?</string>
    <string name="g2_faq_find_a">Open Discover. Search a name, check your phone contacts, or scan the Bucks ID QR on their profile.</string>
    <string name="g2_faq_bother_q">Someone is bothering me. What can I do?</string>
    <string name="g2_faq_bother_a">Open their profile or the message, tap ⋯ and choose Block or Report. They aren\'t told who reported them.</string>
    <string name="g2_faq_dob_q">Why do you ask for my date of birth?</string>
    <string name="g2_faq_dob_a">People under 18 get extra privacy and safety settings, and Indian law needs a parent\'s consent for them. Your birthday is never shown.</string>
    <string name="g2_faq_delete_q">How do I delete my account?</string>
    <string name="g2_faq_delete_a">Settings → Delete account. Your profile, posts, Moments, comments and messages are removed. You can also ask us on the account deletion page.</string>
