    <string name="g2_set_delete_q">உங்கள் கணக்கை நீக்கவா?</string>
    <string name="g2_set_delete_body">இது உங்கள் ப்ரொஃபைல், போன் நம்பர், போஸ்ட்கள், மொமென்ட்ஸ், கமெண்ட்கள், மெசேஜ்கள், சைன் இன் அனைத்தையும் நிரந்தரமாக நீக்கும். இதைத் திரும்பப் பெற முடியாது.</string>
    <string name="g2_set_delete_mine">என் கணக்கை நீக்கு</string>
    <string name="g2_safety_child">உங்கள் கணக்கு பெற்றோருடன் சேர்ந்து நிர்வகிக்கப்படுகிறது. அனுமதிக்கப்பட்ட சிங்க்குகள் மட்டுமே உங்களுக்கு மெசேஜ் செய்ய முடியும்.</string>
    <string name="g2_safety_teen">உங்கள் கணக்குக்கு டீன் பாதுகாப்புகள் ஆன் ஆக உள்ளன.</string>
    <string name="g2_safety_how">Bucks உங்களை எப்படிப் பாதுகாக்கிறது</string>
    <string name="g2_rule_reach">உங்களை யார் தொடர்பு கொள்ளலாம் என்பதை நீங்களே முடிவு செய்யுங்கள்</string>
    <string name="g2_rule_reach_d">இயல்பாக, நீங்கள் சிங்க் ஆனவர்கள் மட்டுமே உங்களுக்கு மெசேஜ் செய்யலாம். தனியுரிமையில் இதை மாற்றலாம்.</string>
    <string name="g2_rule_report">எதையும் புகார் செய்யுங்கள்</string>
    <string name="g2_rule_report_d">ஒவ்வொரு போஸ்ட், கமெண்ட், மொமென்ட், மெசேஜ், ப்ரொஃபைலிலும் \"புகார் செய்\" உள்ளது. புகார்கள் ரகசியமானவை, ஒவ்வொன்றையும் எங்கள் குழு பார்க்கும்.</string>
    <string name="g2_rule_block">ஒரே தட்டலில் பிளாக்</string>
    <string name="g2_rule_block_d">பிளாக் செய்யப்பட்டவர் உங்களுக்கு மெசேஜ் செய்யவோ, சிங்க் செய்யவோ, உங்கள் போஸ்ட்களைப் பார்க்கவோ முடியாது. அவர்களுக்குத் தெரிவிக்கப்படாது.</string>
    <string name="g2_rule_location">உங்கள் சரியான லொகேஷன் ரகசியமாக இருக்கும்</string>
    <string name="g2_rule_location_d">\"அருகில்\" சுமார் 2 கி.மீ பகுதியைப் பயன்படுத்துகிறது. உங்கள் வீடு ஒருபோதும் காட்டப்படாது.</string>
    <string name="g2_rule_minors">18 வயதுக்குக் குறைவானவர்களுக்குக் கூடுதல் கவனம்</string>
    <string name="g2_rule_minors_d">டீன்களின் கணக்கு இயல்பாகவே தனிப்பட்டது. அவர்களுக்குத் தெரியாத பெரியவர்கள் அவர்களைக் கண்டுபிடிக்க முடியாது. அவர்கள் சேரும்போது பெற்றோர் அல்லது பாதுகாவலர் ஒப்புதல் தருவார்.</string>
