    <string name="g3_ob_guardian_body">உங்களுக்கு 18 வயது ஆகவில்லை, அதனால் நீங்கள் Bucks பயன்படுத்தும் முன் பெற்றோர் அல்லது பாதுகாவலர் ஒப்புக்கொள்ள வேண்டும். இந்தப் படிக்கு உங்கள் போனை அவர்களிடம் கொடுங்கள்.</string>
    <string name="g3_ob_parents_title">பெற்றோருக்கு: Bucks டீன்களை எப்படிப் பாதுகாக்கிறது</string>
    <string name="g3_ob_rule_private">அவர்களின் ப்ரொஃபைல் தனிப்பட்டது. இணைப்பில் இல்லாத பெரியவர்கள் தேடலிலோ பரிந்துரைகளிலோ அவர்களைக் கண்டுபிடிக்க முடியாது.</string>
    <string name="g3_ob_rule_messages">அவர்கள் சிங்க் ஆனவர்கள் மட்டுமே அவர்களுக்கு மெசேஜ் செய்ய முடியும்.</string>
    <string name="g3_ob_rule_location">அவர்களின் சரியான லொகேஷன் ஒருபோதும் சேமிக்கப்படாது. அருகிலுள்ள போஸ்ட்கள் சுமார் 2 கி.மீ பகுதியைப் பயன்படுத்துகின்றன.</string>
    <string name="g3_ob_rule_reports">யார் வேண்டுமானாலும் போஸ்ட், மெசேஜ் அல்லது கணக்கைப் புகார் செய்யலாம். ஒவ்வொரு புகாரையும் எங்கள் குழு பார்க்கும்.</string>
