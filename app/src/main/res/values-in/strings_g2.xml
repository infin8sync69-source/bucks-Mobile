    <string name="g2_set_delete_q">Hapus akunmu?</string>
    <string name="g2_set_delete_body">Ini menghapus permanen profil, nomor HP, postingan, Momen, komentar, pesan dan data masukmu. Ini tidak bisa dibatalkan.</string>
    <string name="g2_set_delete_mine">Hapus akunku</string>
    <string name="g2_safety_child">Akunmu dikelola bersama orang tua. Hanya sinkron yang disetujui yang bisa mengirimimu pesan.</string>
