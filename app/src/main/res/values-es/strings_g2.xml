    <string name="g2_rule_reach">Tú decides quién te contacta</string>
    <string name="g2_rule_reach_d">Por defecto, solo las personas sincronizadas contigo pueden escribirte. Cámbialo en Privacidad.</string>
    <string name="g2_rule_report">Reporta lo que sea</string>
    <string name="g2_rule_report_d">Cada publicación, comentario, Momento, mensaje y perfil tiene Reportar. Los reportes son privados y nuestro equipo revisa cada uno.</string>
    <string name="g2_rule_block">Bloquea con un toque</string>
    <string name="g2_rule_block_d">Una persona bloqueada no puede escribirte, sincronizarse contigo ni ver tus publicaciones. No se le avisa.</string>
    <string name="g2_rule_location">Tu ubicación exacta es privada</string>
    <string name="g2_rule_location_d">Cerca usa una zona de unos 2 km. Tu casa nunca se muestra.</string>
    <string name="g2_rule_minors">Cuidado extra para menores de 18</string>
    <string name="g2_rule_minors_d">Los adolescentes son privados por defecto. Los adultos que no conocen no pueden encontrarlos. Un padre, madre o tutor da su consentimiento cuando se unen.</string>
