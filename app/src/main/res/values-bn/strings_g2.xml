    <string name="g2_faq_sync_q">সিঙ্ক কী?</string>
    <string name="g2_faq_sync_a">সিঙ্ক হল দু-দিকের যোগাযোগ, ফ্রেন্ড রিকোয়েস্টের মতো। সিঙ্ক হয়ে গেলে আপনারা একে অপরের সিঙ্কের জন্য পোস্ট দেখতে আর মেসেজ করতে পারবেন।</string>
    <string name="g2_faq_who_q">আমার পোস্ট কারা দেখতে পায়?</string>
    <string name="g2_faq_who_a">প্রতিটা পোস্টের জন্য আপনি বেছে নেন: শুধু সিঙ্ক করা, কাছাকাছি (প্রায় 5 km-এর মধ্যের মানুষ), বা সবাই। মোমেন্টস 24 ঘণ্টা থাকে আর সিঙ্ক করা মানুষ বা কাছের বন্ধুদের কাছে যায়।</string>
    <string name="g2_faq_find_q">বন্ধুদের কীভাবে খুঁজব?</string>
    <string name="g2_faq_find_a">ডিসকভার খুলুন। নাম দিয়ে খুঁজুন, ফোনের কন্ট্যাক্ট দেখুন, বা ওঁর প্রোফাইলের Bucks ID QR স্ক্যান করুন।</string>
    <string name="g2_faq_bother_q">কেউ আমাকে বিরক্ত করছে। কী করব?</string>
    <string name="g2_faq_bother_a">ওঁর প্রোফাইল বা মেসেজটা খুলুন, ⋯ ট্যাপ করে ব্লক বা রিপোর্ট বেছে নিন। কে রিপোর্ট করেছে, ওঁকে জানানো হয় না।</string>
    <string name="g2_faq_dob_q">আমার জন্ম তারিখ কেন চাওয়া হয়?</string>
    <string name="g2_faq_dob_a">18-র কম বয়সীরা বাড়তি প্রাইভেসি আর সুরক্ষা সেটিংস পায়, আর ভারতের আইন অনুযায়ী তাদের জন্য বাবা-মায়ের সম্মতি লাগে। আপনার জন্মদিন কখনও দেখানো হয় না।</string>
    <string name="g2_faq_delete_q">আমার অ্যাকাউন্ট কীভাবে ডিলিট করব?</string>
    <string name="g2_faq_delete_a">সেটিংস → অ্যাকাউন্ট ডিলিট করুন। আপনার প্রোফাইল, পোস্ট, মোমেন্টস, কমেন্ট আর মেসেজ মুছে যাবে। অ্যাকাউন্ট ডিলিটের পেজেও আমাদের বলতে পারেন।</string>
