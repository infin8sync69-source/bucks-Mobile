    <string name="g3_dt_back_to_order">ഓർഡറിലേക്ക് തിരികെ</string>
    <string name="g3_dt_keep_open">ഈ സ്ക്രീൻ തുറന്നുവെക്കുക അല്ലെങ്കിൽ എപ്പോൾ വേണമെങ്കിലും തിരികെ വരിക. ഇത് റൈഡറെ ലൈവായി പിന്തുടരും.</string>
    <string name="g3_ob_welcome_title">നിങ്ങളുടെ ആളുകൾ, തൊട്ടടുത്ത്.</string>
    <string name="g3_ob_point_moments">നിങ്ങൾ സിങ്ക് ചെയ്യുന്നവരുമായി മൊമെന്റ്സും പോസ്റ്റുകളും ഷെയർ ചെയ്യുക</string>
    <string name="g3_ob_point_chat">ഒറ്റയ്ക്കോ ഗ്രൂപ്പുകളിലോ ചാറ്റ് ചെയ്യുക</string>
    <string name="g3_ob_point_safety">ആര് എന്ത് കാണണമെന്ന് നിങ്ങൾ തീരുമാനിക്കുക. ശരിയല്ലാത്തതെന്തും റിപ്പോർട്ട് ചെയ്യുക.</string>
    <string name="g3_ob_get_started">തുടങ്ങാം</string>
    <string name="g3_ob_agree_prefix">തുടരുന്നതിലൂടെ, നിങ്ങൾ ഇനിപ്പറയുന്നവ അംഗീകരിക്കുന്നു:</string>
    <string name="g3_ob_terms">നിബന്ധനകൾ</string>
    <string name="g3_ob_privacy">സ്വകാര്യതാ നയം</string>
    <string name="g3_ob_guidelines">കമ്മ്യൂണിറ്റി മാർഗനിർദേശങ്ങൾ</string>
    <string name="g3_ob_birthday_title">നിങ്ങളുടെ ജന്മദിനം എന്നാണ്?</string>
    <string name="g3_ob_birthday_body">ഞങ്ങൾ എല്ലാവരോടും ചോദിക്കുന്നു. 18 വയസ്സിൽ താഴെയുള്ളവർക്ക് കൂടുതൽ സ്വകാര്യതാ, സുരക്ഷാ സെറ്റിംഗ്സ് ലഭിക്കും. നിങ്ങളുടെ ജന്മദിനം പ്രൊഫൈലിൽ ഒരിക്കലും കാണിക്കില്ല.</string>
    <string name="g3_ob_dob">ജനനത്തീയതി</string>
    <string name="g3_ob_choose_date">തീയതി തിരഞ്ഞെടുക്കുക</string>
    <string name="g3_saving">സേവ് ചെയ്യുന്നു…</string>
    <string name="g3_ob_getting_ready">തയ്യാറാകുന്നു…</string>
    <string name="g3_ok">ശരി</string>
    <string name="g3_cancel">റദ്ദാക്കുക</string>
    <string name="g3_ob_dob_confirm_title">%1$s ശരിയാണോ?</string>
    <string name="g3_ob_dob_confirm_body">സപ്പോർട്ടുമായി ബന്ധപ്പെടാതെ പിന്നീട് ജനനത്തീയതി മാറ്റാനാകില്ല. ഇപ്പോൾ തന്നെ പരിശോധിക്കുക.</string>
    <string name="g3_ob_dob_yes">അതെ, ശരിയാണ്</string>
    <string name="g3_ob_dob_change">മാറ്റുക</string>
    <string name="g3_ob_guardian_title">രക്ഷിതാവിനോട് ചോദിക്കുക</string>
    <string name="g3_ob_guardian_body">നിങ്ങൾക്ക് 18 വയസ്സിൽ താഴെയായതിനാൽ, Bucks ഉപയോഗിക്കുന്നതിന് മുമ്പ് ഒരു രക്ഷിതാവ് സമ്മതിക്കണം. ഈ ഘട്ടത്തിനായി ഫോൺ അവർക്ക് കൈമാറുക.</string>
    <string name="g3_ob_parents_title">രക്ഷിതാക്കൾക്ക്: Bucks കൗമാരക്കാരെ സംരക്ഷിക്കുന്നത് എങ്ങനെ</string>
    <string name="g3_ob_rule_private">അവരുടെ പ്രൊഫൈൽ സ്വകാര്യമാണ്. അവരുമായി ബന്ധമില്ലാത്ത മുതിർന്നവർക്ക് തിരയലിലോ നിർദേശങ്ങളിലോ അവരെ കണ്ടെത്താനാകില്ല.</string>
    <string name="g3_ob_rule_messages">അവർ സിങ്ക് ചെയ്തവർക്ക് മാത്രമേ അവർക്ക് മെസേജ് അയയ്ക്കാനാകൂ.</string>
    <string name="g3_ob_rule_location">അവരുടെ കൃത്യമായ ലൊക്കേഷൻ ഒരിക്കലും സൂക്ഷിക്കില്ല. അടുത്തുള്ള പോസ്റ്റുകൾ ഏകദേശം 2 km പ്രദേശം ഉപയോഗിക്കുന്നു.</string>
    <string name="g3_ob_rule_reports">ആർക്കും ഒരു പോസ്റ്റോ മെസേജോ അക്കൗണ്ടോ റിപ്പോർട്ട് ചെയ്യാം. ഓരോ റിപ്പോർട്ടും ഞങ്ങളുടെ ടീം പരിശോധിക്കും.</string>
    <string name="g3_ob_guardian_name">രക്ഷിതാവിന്റെ മുഴുവൻ പേര്</string>
