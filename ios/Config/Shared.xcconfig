// Defaults first, then Secrets.xcconfig (not committed; create it with scripts/make_secrets.sh) overrides them with the Supabase project,
// the Gemini key, the Mapbox token (empty: OpenStreetMap tiles and search, like Android), the Firebase reversed client id, and the
// support address and grievance officer shown in Help (empty: Help points to the grievance page instead).
SUPABASE_URL =
SUPABASE_ANON_KEY =
GEMINI_API_KEY =
MAPBOX_TOKEN =
REVERSED_CLIENT_ID = com.googleusercontent.apps.not-configured
SUPPORT_EMAIL =
GRIEVANCE_OFFICER =
#include? "Secrets.xcconfig"
